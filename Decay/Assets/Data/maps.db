# maps.db
# Map and area definitions for the MapSystem
#
# MAPS section
#   id | name | scale | map_image_id | unlock_condition
#   map_image_id: asset id registered in assets.db (type=texture), NOT a path
#   unlock_condition: "none" = always unlocked
#                     a map id = unlocked when that map is fully explored
#
# AREAS section
#   id | map_id | area_index | name | button_x | button_y | frames_file
#   area_index: 0-based order within the map (controls button reveal order)
#   frames_file: path to a .txt file listing FRAME ASSET IDS (one per line),
#                each id must be registered in assets.db (type=texture)

[MAPS]
id|name|scale|map_image_id|unlock_condition
forest|Forest|0.390|forest_map|none
castle|Castle|0.385|castle_map|forest
decay|Decay|0.385|decay_map|castle

[AREAS]
id|map_id|area_index|name|button_x|button_y|frames_file
forest_entrance|forest|0|Forest Entrance|150|150|Assets/Wallpapers/ForestTextFiles/forest.txt
forest_darkplains|forest|1|Dark Plains|150|250|Assets/Wallpapers/ForestTextFiles/forestdepths.txt
forest_depths|forest|2|Forest Depths|200|200|Assets/Wallpapers/ForestTextFiles/abyssalwoods.txt
forest_corruption|forest|3|Corruption|300|250|Assets/Wallpapers/ForestTextFiles/abyssaldepths.txt

castle_entrance|castle|0|Castle Entrance|150|150|Assets/Wallpapers/CastleTextFiles/castle.txt
castle_depths|castle|1|Castle Depths|150|250|Assets/Wallpapers/CastleTextFiles/castledepths.txt
castle_chamber|castle|2|Castle Chambers|300|250|Assets/Wallpapers/CastleTextFiles/castlechambers.txt
castle_labyrinth|castle|3|Castle Labyrinth|200|200|Assets/Wallpapers/CastleTextFiles/castlelabyrinth.txt

decay_entrance|decay|0|Crimson Caves|150|150|Assets/Wallpapers/decayTextFiles/decay_entrance.txt
decay_ocean|decay|1|Crimson Ocean|300|159|Assets/Wallpapers/decayTextFiles/decay_ocean.txt
decay_forest|decay|2|Crimson Forest|130|325|Assets/Wallpapers/decayTextFiles/decay_forest.txt
decay_giants|decay|3|Plateau of Giants|500|520|Assets/Wallpapers/decayTextFiles/decay_entrance.txt